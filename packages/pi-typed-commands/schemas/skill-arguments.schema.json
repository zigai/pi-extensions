{
  "type": "object",
  "properties": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigai/pi-typed-commands/schemas/skill-arguments.schema.json",
  "title": "Pi Typed Skill Arguments",
  "description": "Schema for the top-level `arguments` field in SKILL.md frontmatter used by pi-typed-commands.",
  "propertyNames": {
    "type": "string",
    "allOf": [
      {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      {
        "not": {
          "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
        }
      }
    ]
  },
  "additionalProperties": {
    "$ref": "#/$defs/argumentOrNamespace"
  },
  "$defs": {
    "argumentName": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          }
        }
      ]
    },
    "argumentOrNamespace": {
      "anyOf": [
        {
          "$ref": "#/$defs/argument"
        },
        {
          "type": "object",
          "properties": {},
          "propertyNames": {
            "$ref": "#/$defs/argumentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argumentOrNamespace"
          }
        }
      ]
    },
    "shared": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last", "append"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["aliases"]
          }
        },
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "properties": {
        "widget": {
          "enum": [
            "text",
            "textarea",
            "number",
            "toggle",
            "select",
            "radio",
            "multiselect",
            "path",
            "command",
            "readonly",
            "computed",
            "confirm"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stringArgument": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "string"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean"
        },
        "ui": {
          "type": "object",
          "properties": {
            "widget": {
              "enum": [
                "text",
                "textarea",
                "number",
                "toggle",
                "select",
                "radio",
                "multiselect",
                "path",
                "command",
                "readonly",
                "computed",
                "confirm"
              ]
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "default": {
          "type": "string"
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "numberArgument": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "number"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean",
          "const": false
        },
        "ui": {
          "type": "object",
          "properties": {
            "widget": {
              "enum": [
                "text",
                "textarea",
                "number",
                "toggle",
                "select",
                "radio",
                "multiselect",
                "path",
                "command",
                "readonly",
                "computed",
                "confirm"
              ]
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "default": {
          "type": "number"
        },
        "integer": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "booleanArgument": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "boolean"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean",
          "const": false
        },
        "ui": {
          "type": "object",
          "properties": {
            "widget": {
              "enum": [
                "text",
                "textarea",
                "number",
                "toggle",
                "select",
                "radio",
                "multiselect",
                "path",
                "command",
                "readonly",
                "computed",
                "confirm"
              ]
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "default": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "enumArgument": {
      "type": "object",
      "required": ["type", "values"],
      "properties": {
        "type": {
          "type": "string",
          "const": "enum"
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean",
          "const": false
        },
        "ui": {
          "type": "object",
          "properties": {
            "widget": {
              "enum": [
                "text",
                "textarea",
                "number",
                "toggle",
                "select",
                "radio",
                "multiselect",
                "path",
                "command",
                "readonly",
                "computed",
                "confirm"
              ]
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "default": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "multiEnumArgument": {
      "type": "object",
      "required": ["type", "values"],
      "properties": {
        "type": {
          "enum": ["multi_enum", "multi-enum"]
        },
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last", "append"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean"
        },
        "ui": {
          "type": "object",
          "properties": {
            "widget": {
              "enum": [
                "text",
                "textarea",
                "number",
                "toggle",
                "select",
                "radio",
                "multiselect",
                "path",
                "command",
                "readonly",
                "computed",
                "confirm"
              ]
            },
            "rows": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "default": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "min_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "argument": {
      "anyOf": [
        {
          "$ref": "#/$defs/stringArgument"
        },
        {
          "$ref": "#/$defs/numberArgument"
        },
        {
          "$ref": "#/$defs/booleanArgument"
        },
        {
          "$ref": "#/$defs/enumArgument"
        },
        {
          "$ref": "#/$defs/multiEnumArgument"
        }
      ]
    }
  }
}
