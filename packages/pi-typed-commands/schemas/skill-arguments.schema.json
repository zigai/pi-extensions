{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigai/pi-typed-commands/schemas/skill-arguments.schema.json",
  "title": "Pi Typed Skill Arguments",
  "description": "Schema for the top-level `arguments` field in SKILL.md frontmatter used by pi-typed-commands.",
  "type": "object",
  "propertyNames": {
    "$ref": "#/$defs/argumentName"
  },
  "additionalProperties": {
    "$ref": "#/$defs/argumentOrNamespace"
  },
  "$defs": {
    "argumentName": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        {
          "not": {
            "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
          }
        }
      ]
    },
    "argumentOrNamespace": {
      "oneOf": [
        {
          "$ref": "#/$defs/argument"
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/argumentName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argumentOrNamespace"
          }
        }
      ]
    },
    "shared": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "placeholder": {
          "type": "string"
        },
        "occurrence": {
          "enum": ["error", "first", "last", "append"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "rest": {
          "type": "boolean"
        },
        "positional": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["aliases"]
          }
        },
        {
          "not": {
            "required": ["required", "default"],
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widget": {
          "enum": [
            "text",
            "textarea",
            "number",
            "toggle",
            "select",
            "radio",
            "multiselect",
            "path",
            "command",
            "readonly",
            "computed",
            "confirm"
          ]
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "stringArgument": {
      "allOf": [
        {
          "$ref": "#/$defs/shared"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "string"
            },
            "description": true,
            "title": true,
            "required": true,
            "default": {
              "type": "string"
            },
            "placeholder": true,
            "occurrence": {
              "enum": ["error", "first", "last"]
            },
            "position": true,
            "rest": true,
            "positional": true,
            "ui": true,
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            }
          }
        }
      ]
    },
    "numberArgument": {
      "allOf": [
        {
          "$ref": "#/$defs/shared"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "number"
            },
            "description": true,
            "title": true,
            "required": true,
            "default": {
              "type": "number"
            },
            "placeholder": true,
            "occurrence": {
              "enum": ["error", "first", "last"]
            },
            "position": true,
            "rest": {
              "const": false
            },
            "positional": true,
            "ui": true,
            "integer": {
              "type": "boolean"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "booleanArgument": {
      "allOf": [
        {
          "$ref": "#/$defs/shared"
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "boolean"
            },
            "description": true,
            "title": true,
            "required": true,
            "default": {
              "type": "boolean"
            },
            "placeholder": true,
            "occurrence": {
              "enum": ["error", "first", "last"]
            },
            "position": true,
            "rest": {
              "const": false
            },
            "positional": true,
            "ui": true
          }
        }
      ]
    },
    "enumArgument": {
      "allOf": [
        {
          "$ref": "#/$defs/shared"
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "enum"
            },
            "description": true,
            "title": true,
            "required": true,
            "default": {
              "type": "string"
            },
            "placeholder": true,
            "occurrence": {
              "enum": ["error", "first", "last"]
            },
            "position": true,
            "rest": {
              "const": false
            },
            "positional": true,
            "ui": true,
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "multiEnumArgument": {
      "allOf": [
        {
          "$ref": "#/$defs/shared"
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["multi_enum", "multi-enum"]
            },
            "description": true,
            "title": true,
            "required": true,
            "default": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "placeholder": true,
            "occurrence": true,
            "position": true,
            "rest": true,
            "positional": true,
            "ui": true,
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "min_items": {
              "type": "integer",
              "minimum": 0
            },
            "max_items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "argument": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringArgument"
        },
        {
          "$ref": "#/$defs/numberArgument"
        },
        {
          "$ref": "#/$defs/booleanArgument"
        },
        {
          "$ref": "#/$defs/enumArgument"
        },
        {
          "$ref": "#/$defs/multiEnumArgument"
        }
      ]
    }
  }
}
