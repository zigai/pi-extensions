{
  "name": "pi-typed-args",
  "version": "0.1.0",
  "description": "Typed input definitions for Pi slash commands and Agent Skills — parsing, completions, help, and forms from a single definition.",
  "keywords": [
    "commands",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "slash-commands",
    "typed-args",
    "typed-input"
  ],
  "homepage": "https://github.com/zigai/pi-typed-commands#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-typed-commands/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-typed-commands.git"
  },
  "files": [
    "src",
    "schemas",
    "config.schema.json",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./command": "./src/pi/command.ts",
    "./pi": "./src/pi/index.ts",
    "./skills": "./src/skills/index.ts",
    "./pi-tui": "./src/pi-tui/index.ts",
    "./schema": "./schemas/skill-arguments.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check",
    "release": "release --root .",
    "release:dry-run": "release --dry --root ."
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.10.1",
    "fast-check": "^4.8.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.0.0"
}
