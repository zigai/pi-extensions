{
  "name": "@zigai/pi-extension-settings",
  "version": "0.5.2",
  "description": "TypeBox-first configuration runtime and artifact tooling for Pi extensions.",
  "keywords": [
    "configuration",
    "json-schema",
    "pi-coding-agent",
    "pi-extension",
    "typebox",
    "typescript"
  ],
  "homepage": "https://github.com/zigai/pi-extension-settings#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-extension-settings/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-extension-settings.git"
  },
  "bin": {
    "pi-extension-settings": "dist/cli-entry.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.ts"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-pi-runtime.ts",
    "lint": "oxlint -c ./oxlint.config.ts .",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:package": "node scripts/package-check.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run coverage && npm run test:package",
    "verify": "npm run check",
    "prepack": "npm run check"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "4.1.4",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-rules": "0.2.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0"
}
