{
  "name": "pi-typed-args",
  "version": "0.1.1",
  "description": "Typed input definitions for Pi slash commands and Agent Skills — parsing, completions, help, and forms from a single definition.",
  "keywords": [
    "commands",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "slash-commands",
    "typed-args",
    "typed-input"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/packages/pi-typed-args#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "packages/pi-typed-args"
  },
  "files": [
    "src",
    "schemas",
    "config.schema.json",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./command": "./src/pi/command.ts",
    "./pi": "./src/pi/index.ts",
    "./skills": "./src/skills/index.ts",
    "./pi-tui": "./src/pi-tui/index.ts",
    "./schema": "./schemas/skill-arguments.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node ../../scripts/tracked-check.ts lint",
    "lint:fix": "node ../../scripts/tracked-check.ts lint:fix",
    "format": "node ../../scripts/tracked-check.ts format",
    "format:check": "node ../../scripts/tracked-check.ts format:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check",
    "release": "release --root ../..",
    "release:dry-run": "release --dry --root ../.."
  },
  "dependencies": {
    "typebox": "^1.3.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.9",
    "fast-check": "^4.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0"
}
