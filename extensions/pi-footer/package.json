{
  "name": "@zigai/pi-footer",
  "version": "0.8.0",
  "description": "Pi package that replaces Pi's footer with a compact status line.",
  "keywords": [
    "footer",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-tweaks"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-footer#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-footer"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "*.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zigai/pi-extension-internals": "0.2.0",
    "@zigai/pi-extension-settings": "0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/zigai/pi-tweaks/master/extensions/pi-footer/assets/footer.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md",
    "prevalidation": "./src/settings.prevalidated.ts"
  }
}
