{
  "name": "pi-autoname-session",
  "version": "0.1.0",
  "private": true,
  "description": "Automatically name new Pi sessions",
  "keywords": [
    "autoname-session",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/my-user/pi-autoname-session#readme",
  "bugs": {
    "url": "https://github.com/my-user/pi-autoname-session/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-user/pi-autoname-session.git"
  },
  "files": [
    "src",
    "README.md",
    "config.schema.json",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run config:check && npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check",
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@zigai/pi-extension-settings"
  ],
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.18.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md"
  }
}
