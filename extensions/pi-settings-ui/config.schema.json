{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zigai/pi-tweaks/master/extensions/pi-settings-ui/config.schema.json",
  "title": "Pi Settings UI settings",
  "description": "Settings for Pi Settings UI.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "default": "./schemas/pi-settings-ui.schema.json",
      "description": "JSON Schema used by editors for this settings file."
    },
    "header": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "stacked",
            "compact"
          ],
          "default": "stacked",
          "description": "Separate navigation and scope, or combine them when space allows."
        },
        "showHints": {
          "type": "boolean",
          "default": true,
          "description": "Show the tab-picker shortcut in the settings header."
        },
        "showFieldCounter": {
          "type": "boolean",
          "default": true,
          "description": "Show the current field position in the settings header."
        }
      },
      "default": {
        "layout": "stacked",
        "showHints": true,
        "showFieldCounter": true
      },
      "additionalProperties": false
    },
    "projectOverrides": {
      "type": "boolean",
      "default": true,
      "description": "Let trusted projects have their own extension settings."
    }
  }
}
