{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/zigai/pi-tweaks/master/extensions/pi-message-timestamps/config.schema.json",
  "title": "Pi Message Timestamps settings",
  "description": "Settings for message timestamps.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "default": "./schemas/pi-message-timestamps.schema.json",
      "description": "JSON Schema used by editors for this settings file."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Show timestamps on messages."
    },
    "format": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "const": "time-only"
        },
        {
          "type": "string",
          "const": "date-time"
        },
        {
          "type": "string",
          "const": "relative"
        }
      ],
      "default": "auto",
      "description": "Timestamp format: auto shows time today and date and time on other days; time-only, date-time, or relative always use that format."
    },
    "assistantPlacement": {
      "anyOf": [
        {
          "type": "string",
          "const": "first-line"
        },
        {
          "type": "string",
          "const": "last-line"
        },
        {
          "type": "string",
          "const": "below"
        }
      ],
      "default": "first-line",
      "description": "Where response timestamps appear: first-line puts the time right of the first line; last-line puts it right of the last line; below adds a blank line and then a line with the time, model, duration, and tokens."
    }
  }
}
