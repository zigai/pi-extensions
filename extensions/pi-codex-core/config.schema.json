{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigai/pi-codex-core/config.schema.json",
  "type": "object",
  "required": ["scope", "tools", "prompt", "compaction", "recovery", "openai"],
  "properties": {
    "scope": {
      "type": "object",
      "required": ["tools"],
      "properties": {
        "tools": {
          "anyOf": [
            {
              "type": "string",
              "const": "codex"
            },
            {
              "type": "string",
              "const": "all"
            }
          ]
        }
      },
      "additionalProperties": false,
      "default": {
        "tools": "codex"
      }
    },
    "tools": {
      "type": "object",
      "required": [
        "webSearch",
        "webSearchMode",
        "imageGeneration",
        "viewImage",
        "viewImageDescriptions",
        "applyPatch"
      ],
      "properties": {
        "webSearch": {
          "type": "boolean",
          "default": true
        },
        "webSearchMode": {
          "anyOf": [
            {
              "type": "string",
              "const": "cached"
            },
            {
              "type": "string",
              "const": "indexed"
            },
            {
              "type": "string",
              "const": "live"
            }
          ],
          "default": "live"
        },
        "imageGeneration": {
          "type": "boolean",
          "default": true
        },
        "viewImage": {
          "type": "boolean",
          "default": true
        },
        "viewImageDescriptions": {
          "type": "boolean",
          "default": false
        },
        "applyPatch": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "openai"
            },
            {
              "type": "string",
              "const": "all"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "required": ["mode", "personality"],
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "pi"
            },
            {
              "type": "string",
              "const": "codex"
            }
          ]
        },
        "personality": {
          "anyOf": [
            {
              "type": "string",
              "const": "friendly"
            },
            {
              "type": "string",
              "const": "pragmatic"
            },
            {
              "type": "string",
              "const": "none"
            }
          ]
        }
      },
      "additionalProperties": false,
      "default": {
        "mode": "codex",
        "personality": "pragmatic"
      }
    },
    "compaction": {
      "type": "object",
      "required": ["enabled", "auto", "thresholdPercent"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "auto": {
          "type": "boolean",
          "default": true
        },
        "thresholdPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 80
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["enabled", "batchFollowUps", "maxAttempts", "baseDelayMs", "maxDelayMs"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "batchFollowUps": {
          "type": "boolean",
          "default": true
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "baseDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000,
          "default": 120000
        }
      },
      "additionalProperties": false
    },
    "openai": {
      "type": "object",
      "required": [
        "webSearchModel",
        "imageModel",
        "imageDescriptionModel",
        "compactionModel",
        "compactionReasoning",
        "verbosity",
        "fast",
        "showReasoningTraces"
      ],
      "properties": {
        "webSearchModel": {
          "type": "string",
          "default": "current"
        },
        "imageModel": {
          "type": "string",
          "default": "gpt-image-2"
        },
        "imageDescriptionModel": {
          "type": "string",
          "default": "current"
        },
        "compactionModel": {
          "type": "string",
          "default": "current"
        },
        "compactionReasoning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "default": "medium"
        },
        "verbosity": {
          "anyOf": [
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            }
          ]
        },
        "fast": {
          "type": "boolean",
          "default": false
        },
        "showReasoningTraces": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
