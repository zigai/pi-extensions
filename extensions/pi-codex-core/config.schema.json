{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigai/pi-codex-core/config.schema.json",
  "title": "Pi Codex Core settings",
  "description": "Everything GPT models need to feel at home in Pi.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "default": "./schemas/pi-codex-core.schema.json",
      "description": "JSON Schema used by editors for this settings file."
    },
    "scope": {
      "type": "object",
      "properties": {
        "tools": {
          "anyOf": [
            {
              "type": "string",
              "const": "codex"
            },
            {
              "type": "string",
              "const": "all"
            }
          ],
          "default": "codex",
          "description": "Expose Codex tools only for Codex models (`codex`) or for all models (`all`)."
        }
      },
      "additionalProperties": false,
      "default": {
        "tools": "codex"
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "webSearch": {
          "type": "boolean",
          "default": true,
          "description": "Enable the `web_run` web search tool."
        },
        "webSearchMode": {
          "anyOf": [
            {
              "type": "string",
              "const": "cached"
            },
            {
              "type": "string",
              "const": "indexed"
            },
            {
              "type": "string",
              "const": "live"
            }
          ],
          "default": "live",
          "description": "Set search mode: `cached`, `indexed`, or `live`."
        },
        "imageGeneration": {
          "type": "boolean",
          "default": true,
          "description": "Enable the `imagegen` image generation and editing tool."
        },
        "viewImage": {
          "type": "boolean",
          "default": true,
          "description": "Enable the `view_image` local image viewing tool."
        },
        "viewImageDescriptions": {
          "type": "boolean",
          "default": false,
          "description": "Include Codex-generated descriptions when viewing images."
        },
        "applyPatch": {
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "string",
              "const": "openai"
            },
            {
              "type": "string",
              "const": "all"
            }
          ],
          "default": "off",
          "description": "Replace standard `edit` with `apply_patch`: `off`, `openai`, or `all`."
        }
      },
      "additionalProperties": false,
      "default": {
        "webSearch": true,
        "webSearchMode": "live",
        "imageGeneration": true,
        "viewImage": true,
        "viewImageDescriptions": false,
        "applyPatch": "off"
      }
    },
    "prompt": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "pi"
            },
            {
              "type": "string",
              "const": "codex"
            }
          ],
          "default": "codex",
          "description": "Enable model-aware Codex prompts (`codex`) or standard Pi prompts (`pi`)."
        },
        "personality": {
          "anyOf": [
            {
              "type": "string",
              "const": "friendly"
            },
            {
              "type": "string",
              "const": "pragmatic"
            },
            {
              "type": "string",
              "const": "none"
            }
          ],
          "default": "pragmatic",
          "description": "Set Codex communication style: `friendly`, `pragmatic`, or `none`."
        }
      },
      "additionalProperties": false,
      "default": {
        "mode": "codex",
        "personality": "pragmatic"
      }
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Codex-style conversation compaction."
        },
        "auto": {
          "type": "boolean",
          "default": true,
          "description": "Automatically trigger compaction when reaching the context threshold."
        },
        "thresholdPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "default": 80,
          "description": "Context percentage threshold that triggers auto-compaction."
        }
      },
      "additionalProperties": false,
      "default": {
        "enabled": true,
        "auto": true,
        "thresholdPercent": 80
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Resume transiently failed Codex turns after Pi exhausts retries."
        },
        "batchFollowUps": {
          "type": "boolean",
          "default": false,
          "description": "Deliver user follow-up messages sent during a turn together when it completes."
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3,
          "description": "Maximum delayed resume attempts for a failed turn."
        },
        "baseDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000,
          "default": 30000,
          "description": "Initial recovery delay in milliseconds."
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000,
          "default": 120000,
          "description": "Maximum recovery delay in milliseconds."
        }
      },
      "additionalProperties": false,
      "default": {
        "enabled": true,
        "batchFollowUps": false,
        "maxAttempts": 3,
        "baseDelayMs": 30000,
        "maxDelayMs": 120000
      }
    },
    "openai": {
      "type": "object",
      "properties": {
        "webSearchModel": {
          "type": "string",
          "default": "current",
          "description": "Model for `web_run`; `current` uses the active model."
        },
        "imageModel": {
          "type": "string",
          "default": "gpt-image-2",
          "description": "Model for `imagegen`."
        },
        "imageDescriptionModel": {
          "type": "string",
          "default": "current",
          "description": "Model for image descriptions; `current` uses the active model."
        },
        "compactionModel": {
          "type": "string",
          "default": "current",
          "description": "Model for compaction; `current` uses the active model."
        },
        "compactionReasoning": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "default": "medium",
          "description": "Reasoning effort for compaction requests: `medium`, `current`, `max`, or `ultra`."
        },
        "verbosity": {
          "anyOf": [
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "medium"
            },
            {
              "type": "string",
              "const": "high"
            }
          ],
          "default": "low",
          "description": "Verbosity level for Codex API requests: `low`, `medium`, or `high`."
        },
        "fast": {
          "type": "boolean",
          "default": false,
          "description": "Prioritize speed for supported OpenAI models."
        },
        "showReasoningTraces": {
          "type": "boolean",
          "default": true,
          "description": "Stream reasoning trace summaries for GPT Responses models."
        }
      },
      "additionalProperties": false,
      "default": {
        "webSearchModel": "current",
        "imageModel": "gpt-image-2",
        "imageDescriptionModel": "current",
        "compactionModel": "current",
        "compactionReasoning": "medium",
        "verbosity": "low",
        "fast": false,
        "showReasoningTraces": true
      }
    }
  }
}
