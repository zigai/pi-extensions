{
  "name": "@zigai/pi-codex-core",
  "version": "1.3.0",
  "description": "Everything GPT models need to feel at home in Pi.",
  "keywords": [
    "pi",
    "pi-codex-compaction",
    "pi-codex-system-prompt",
    "pi-codex-tools",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-web-search"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-codex-core#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-codex-core"
  },
  "files": [
    "src",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check",
    "lint": "node ../../scripts/tracked-check.ts lint",
    "lint:fix": "node ../../scripts/tracked-check.ts lint:fix",
    "format": "node ../../scripts/tracked-check.ts format",
    "format:check": "node ../../scripts/tracked-check.ts format:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run check:code",
    "check:code": "npm run config:check && npm run typecheck && npm test",
    "verify": "npm run check",
    "release": "release --root ../..",
    "release:dry-run": "release --dry --root ../.."
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.6.0",
    "@zigai/pi-glowup": "1.1.0",
    "better-result": "^2.9.2",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.9",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "prevalidation": "./src/settings.prevalidated.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md"
  }
}
