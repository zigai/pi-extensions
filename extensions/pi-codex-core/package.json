{
  "name": "@zigai/pi-codex-core",
  "version": "0.1.0",
  "description": "Everything GPT models need to feel at home in Pi.",
  "keywords": [
    "pi",
    "pi-codex-compaction",
    "pi-codex-system-prompt",
    "pi-codex-tools",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-web-search"
  ],
  "homepage": "https://github.com/zigai/pi-codex-core#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-codex-core/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-codex-core.git"
  },
  "files": [
    "src",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./oxlint.config.ts . --format default",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix --format default",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check"
  },
  "dependencies": {
    "@zigai/pi-glowup": "file:../pi-glowup",
    "better-result": "^2.9.2",
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.9",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.74.0",
    "oxlint-rules": "latest",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@zigai/pi-glowup"
  ],
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.0.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
