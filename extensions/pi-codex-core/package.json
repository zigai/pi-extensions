{
  "name": "pi-codex-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension for codex core.",
  "keywords": [
    "codex-core",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-codex-core#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-codex-core/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-codex-core.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "node --experimental-test-coverage --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.0.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
