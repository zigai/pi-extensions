{
  "name": "@zigai/pi-mention-anything",
  "version": "0.2.1",
  "description": "Define arbitrary mention sources and triggers for Pi.",
  "keywords": [
    "autocomplete",
    "custom",
    "mention",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-mention-anything#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-mention-anything"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "config.schema.json",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zigai/pi-extension-internals": "0.2.0",
    "@zigai/pi-extension-settings": "0.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md",
    "prevalidation": "./src/settings.prevalidated.ts"
  }
}
