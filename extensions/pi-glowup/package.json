{
  "name": "@zigai/pi-glowup",
  "version": "0.3.0",
  "description": "Compact, high-signal rendering for Pi tool calls and results.",
  "keywords": [
    "glowup",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "rendering"
  ],
  "homepage": "https://github.com/zigai/pi-glowup#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-glowup/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-glowup.git"
  },
  "files": [
    "dist",
    "src/settings-input.ts",
    "src/settings.prevalidated.ts",
    "src/unknown-values.ts",
    "src/rendering/preview-settings.ts",
    "src/tools/protocol/decode.ts",
    "src/tools/protocol/contract.ts",
    "src/tools/protocol/nodes.ts",
    "src/json-value.ts",
    "docs",
    "themes",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/src/index.ts",
  "exports": {
    ".": "./dist/src/index.ts",
    "./protocol": "./src/tools/protocol/contract.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/build.mjs",
    "lint": "oxlint -c ./oxlint.config.ts .",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npm run test:vitest && npm run test:pty",
    "test:vitest": "vitest run --exclude=test/pty/**",
    "test:xterm": "vitest run test/xterm/tui-integration.test.ts",
    "test:pty": "vitest run test/pty/pi-cli.test.ts",
    "test:properties": "vitest run test/tools/built-in/streaming-render-properties.test.ts",
    "test:package": "npm run build && node scripts/package-check.mjs",
    "benchmark:tui": "node --expose-gc --import tsx benchmark/tui-rendering.ts",
    "language-catalog:generate": "node scripts/generate-language-catalog.mjs",
    "language-catalog:check": "node scripts/generate-language-catalog.mjs --check",
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run config:check && npm run language-catalog:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:package",
    "verify": "npm run check",
    "prepack": "npm run config:check && npm run language-catalog:check && npm run build"
  },
  "dependencies": {
    "@pierre/diffs": "1.2.12",
    "@zigai/pi-extension-settings": "0.5.3",
    "ansi-styles": "^6.2.3",
    "shiki": "4.3.0",
    "unbash": "4.0.10"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@fast-check/vitest": "^0.4.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "node-pty": "^1.1.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.74.0",
    "oxlint-rules": "0.4.1",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.1",
    "typebox": "^1.3.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.0.0",
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true
  },
  "pi": {
    "extensions": [
      "./dist/src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "schema": "./config.schema.json",
    "prevalidation": "./src/settings.prevalidated.ts",
    "readme": "./README.md"
  }
}
