{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigai/pi-codex-look/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "preserveTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appearance": {
      "type": "object",
      "properties": {
        "diffBackgroundStyle": {
          "anyOf": [
            {
              "type": "string",
              "const": "changed-spans"
            },
            {
              "type": "string",
              "const": "two-tone"
            },
            {
              "type": "string",
              "const": "full-row"
            }
          ],
          "description": "Background treatment for changed diff rows and intraline spans."
        },
        "diffLineNumberStyle": {
          "anyOf": [
            {
              "type": "string",
              "const": "single"
            },
            {
              "type": "string",
              "const": "dual"
            }
          ],
          "description": "Show one relevant line number or aligned old and new line-number columns."
        },
        "narrowDiffLayout": {
          "anyOf": [
            {
              "type": "string",
              "const": "paired"
            },
            {
              "type": "string",
              "const": "traditional"
            }
          ],
          "description": "Order similar deletion/addition rows together or in traditional blocks."
        },
        "sideBySideLayout": {
          "anyOf": [
            {
              "type": "string",
              "const": "content-aware"
            },
            {
              "type": "string",
              "const": "fixed"
            }
          ],
          "description": "Choose split diffs from content fit or a fixed terminal-width threshold."
        },
        "addedRowBackground": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Subtle addition-row background; null derives it from the active Pi theme."
        },
        "deletedRowBackground": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Subtle deletion-row background; null derives it from the active Pi theme."
        },
        "addedContentBackground": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stronger added intraline-span background; null derives a contrasting shade."
        },
        "deletedContentBackground": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stronger deleted intraline-span background; null derives a contrasting shade."
        },
        "instructionPathColor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Instruction-file path foreground; null inherits the active Pi theme."
        },
        "dimUnchangedDiffText": {
          "description": "Dim unchanged text around changed intraline spans.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "default": {
        "diffBackgroundStyle": "two-tone",
        "diffLineNumberStyle": "dual",
        "narrowDiffLayout": "paired",
        "sideBySideLayout": "content-aware",
        "addedRowBackground": null,
        "deletedRowBackground": null,
        "addedContentBackground": null,
        "deletedContentBackground": null,
        "instructionPathColor": null,
        "dimUnchangedDiffText": false
      }
    },
    "debugLog": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "maxBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "memorySampleIntervalMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {
        "enabled": false,
        "path": "debug.log",
        "maxBytes": null,
        "memorySampleIntervalMs": 10000
      }
    },
    "toolLabels": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "static"
            },
            {
              "type": "string",
              "const": "lifecycle"
            }
          ]
        }
      },
      "additionalProperties": false,
      "default": {
        "mode": "static"
      }
    },
    "toolCallIndicator": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "pattern": "\\S"
        },
        "bold": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "default": {
        "symbol": "•",
        "bold": true
      }
    },
    "writePreview": {
      "type": "object",
      "properties": {
        "movingViewport": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "default": {
        "movingViewport": true
      }
    },
    "syntax": {
      "type": "object",
      "properties": {
        "preloadLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bracketPairColoring": {
          "description": "Color matching bracket pairs; false preserves the syntax theme foreground.",
          "type": "boolean"
        },
        "projectLanguageDetection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "default": {
            "enabled": true
          }
        }
      },
      "additionalProperties": false,
      "default": {
        "preloadLanguages": ["markdown", "bash", "python", "typescript", "javascript", "json"],
        "bracketPairColoring": true,
        "projectLanguageDetection": {
          "enabled": true
        }
      }
    },
    "patches": {
      "type": "object",
      "properties": {
        "assistantSeparator": {
          "type": "boolean"
        },
        "workingWidgetSpacing": {
          "type": "boolean"
        },
        "autocompleteCleanup": {
          "type": "boolean"
        },
        "markdownSyntax": {
          "type": "boolean"
        },
        "thirdPartyToolRenderers": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "default": {
        "assistantSeparator": true,
        "workingWidgetSpacing": false,
        "autocompleteCleanup": true,
        "markdownSyntax": true,
        "thirdPartyToolRenderers": true
      }
    },
    "scriptPreview": {
      "type": "object",
      "properties": {
        "headerLayout": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string",
              "const": "inline"
            },
            {
              "type": "string",
              "const": "block"
            }
          ]
        },
        "maxCodePreviewLines": {
          "type": "integer",
          "minimum": 4
        },
        "formatters": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      },
      "additionalProperties": false,
      "default": {
        "headerLayout": "auto",
        "maxCodePreviewLines": 8,
        "formatters": {}
      }
    }
  },
  "additionalProperties": false
}
