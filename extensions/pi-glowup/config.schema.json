{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zigai/pi-codex-look/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "preserveTools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appearance": {
      "type": "object",
      "properties": {
        "diffBackgroundStyle": {
          "anyOf": [
            {
              "type": "string",
              "const": "changed-spans"
            },
            {
              "type": "string",
              "const": "full-row"
            }
          ]
        },
        "narrowDiffLayout": {
          "anyOf": [
            {
              "type": "string",
              "const": "paired"
            },
            {
              "type": "string",
              "const": "traditional"
            }
          ]
        },
        "sideBySideLayout": {
          "anyOf": [
            {
              "type": "string",
              "const": "content-aware"
            },
            {
              "type": "string",
              "const": "fixed"
            }
          ]
        },
        "addedRowBackground": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "deletedRowBackground": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructionPathColor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "default": {
        "diffBackgroundStyle": "changed-spans",
        "narrowDiffLayout": "paired",
        "sideBySideLayout": "content-aware",
        "addedRowBackground": null,
        "deletedRowBackground": null,
        "instructionPathColor": null
      }
    },
    "debugLog": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "maxBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "memorySampleIntervalMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {
        "enabled": false,
        "path": "debug.log",
        "maxBytes": null,
        "memorySampleIntervalMs": 10000
      }
    },
    "toolLabels": {
      "type": "object",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "static"
            },
            {
              "type": "string",
              "const": "lifecycle"
            }
          ]
        }
      },
      "additionalProperties": false,
      "default": {
        "mode": "static"
      }
    },
    "writePreview": {
      "type": "object",
      "properties": {
        "movingViewport": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "default": {
        "movingViewport": true
      }
    },
    "syntax": {
      "type": "object",
      "properties": {
        "preloadLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectLanguageDetection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "default": {
            "enabled": true
          }
        }
      },
      "additionalProperties": false,
      "default": {
        "preloadLanguages": ["markdown", "bash", "python", "typescript", "javascript", "json"],
        "projectLanguageDetection": {
          "enabled": true
        }
      }
    },
    "patches": {
      "type": "object",
      "properties": {
        "assistantSeparator": {
          "type": "boolean"
        },
        "workingWidgetSpacing": {
          "type": "boolean"
        },
        "autocompleteCleanup": {
          "type": "boolean"
        },
        "markdownSyntax": {
          "type": "boolean"
        },
        "thirdPartyToolRenderers": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "default": {
        "assistantSeparator": true,
        "workingWidgetSpacing": false,
        "autocompleteCleanup": true,
        "markdownSyntax": true,
        "thirdPartyToolRenderers": true
      }
    },
    "scriptPreview": {
      "type": "object",
      "properties": {
        "headerLayout": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "string",
              "const": "inline"
            },
            {
              "type": "string",
              "const": "block"
            }
          ]
        },
        "maxCodePreviewLines": {
          "type": "integer",
          "minimum": 4
        },
        "formatters": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      },
      "additionalProperties": false,
      "default": {
        "headerLayout": "auto",
        "maxCodePreviewLines": 8,
        "formatters": {}
      }
    }
  },
  "additionalProperties": false
}
