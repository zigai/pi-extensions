{
  "name": "@zigai/pi-goal",
  "version": "0.1.36",
  "description": "Codex-style goal tracking and continuation for pi.",
  "keywords": [
    "codex",
    "extension",
    "goal",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-goal#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-goal"
  },
  "files": [
    "src",
    "docs",
    "scripts",
    "AGENTS.md",
    "prompts",
    "platform-verification.config.mjs",
    ".crabboxignore",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "node ../../scripts/tracked-check.ts lint",
    "lint:fix": "node ../../scripts/tracked-check.ts lint:fix",
    "format": "node ../../scripts/tracked-check.ts format",
    "format:check": "node ../../scripts/tracked-check.ts format:check",
    "test": "vitest run",
    "test:tui": "vitest run test/glowup-rendering.test.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:platform-verification": "node scripts/platform-verification/check.mjs",
    "check": "npm run lint && npm run check:code",
    "check:code": "npm run typecheck && npm run check:platform-verification && npm test",
    "verify": "npm run check",
    "verify:platform": "node scripts/platform-verification.mjs",
    "verify:platform:doctor": "node scripts/platform-verification.mjs doctor",
    "verify:platform:macos": "node scripts/platform-verification.mjs run --target macos",
    "verify:platform:ubuntu": "node scripts/platform-verification.mjs run --target ubuntu",
    "verify:platform:windows-native": "node scripts/platform-verification.mjs run --target windows-native",
    "verify:platform:all": "node scripts/platform-verification.mjs doctor --skip-windows-disposable-probe && node scripts/platform-verification.mjs run --target macos,ubuntu,windows-native"
  },
  "dependencies": {
    "@zigai/pi-glowup": "1.0.0",
    "pi-typed-args": "0.1.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.9",
    "@xterm/headless": "^6.0.0",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "lintStages": [
    {
      "targets": [
        "src",
        "test"
      ]
    },
    {
      "targets": [
        "scripts",
        "platform-verification.config.mjs"
      ]
    }
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
