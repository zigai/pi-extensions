{
  "name": "@zigai/pi-toggles",
  "version": "0.1.0",
  "description": "Central capability policy, profiles, conditions, and session overrides for Pi",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "toggles"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-toggles#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-toggles"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "docs",
    "README.md",
    "config.schema.json",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run config:check && npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check",
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.5.3",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.9",
    "@xterm/headless": "^6.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md",
    "prevalidation": "./src/settings.prevalidated.ts"
  }
}
