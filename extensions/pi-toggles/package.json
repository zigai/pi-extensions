{
  "name": "@zigai/pi-toggles",
  "version": "0.1.0",
  "description": "Central capability policy, profiles, conditions, and session overrides for Pi",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "toggles"
  ],
  "homepage": "https://github.com/zigai/pi-toggles#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-toggles/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-toggles.git"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "docs",
    "README.md",
    "config.schema.json",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "check": "npm run config:check && npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check",
    "config:generate": "pi-extension-settings generate",
    "config:check": "pi-extension-settings check"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.2.2",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "bundleDependencies": [
    "@zigai/pi-extension-settings"
  ],
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.18.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md"
  }
}
