{
  "name": "pi-expanded-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Expanded Pi skills",
  "keywords": [
    "expanded-skills",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-expanded-skills#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-expanded-skills/issues"
  },
  "license": "UNLICENSED",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-expanded-skills.git"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.9",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.0.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
