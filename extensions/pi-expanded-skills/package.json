{
  "name": "@zigai/pi-enhanced-skills",
  "version": "0.1.0",
  "description": "Enhanced Pi skills",
  "keywords": [
    "enhanced-skills",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-expanded-skills#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "UNLICENSED",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-expanded-skills"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify": "npm run check"
  },
  "dependencies": {},
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.9",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
