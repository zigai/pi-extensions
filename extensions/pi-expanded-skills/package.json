{
  "name": "@zigai/pi-enhanced-skills",
  "version": "0.1.1",
  "description": "Enhanced Pi skills",
  "keywords": [
    "enhanced-skills",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-expanded-skills#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-expanded-skills"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node ../../scripts/tracked-check.ts lint",
    "lint:fix": "node ../../scripts/tracked-check.ts lint:fix",
    "format": "node ../../scripts/tracked-check.ts format",
    "format:check": "node ../../scripts/tracked-check.ts format:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run check:code",
    "check:code": "npm run typecheck && npm test",
    "verify": "npm run check"
  },
  "dependencies": {
    "@zigai/pi-extension-internals": "0.2.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
