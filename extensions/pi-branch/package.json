{
  "name": "@zigai/pi-branch",
  "version": "0.1.0",
  "description": "Pi package for branching the current session into parallel tmux or Ghostty panes.",
  "keywords": [
    "branch",
    "fork",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "session"
  ],
  "homepage": "https://github.com/zigai/pi-branch#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-branch/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-branch.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./.oxlintrc.json .",
    "lint:fix": "oxlint -c ./.oxlintrc.json . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pi-typed-commands": "file:../pi-typed-commands",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.8",
    "@earendil-works/pi-tui": "^0.79.8",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.8"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
