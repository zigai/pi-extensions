{
  "name": "@zigai/pi-branch",
  "version": "0.1.0",
  "description": "Pi package for branching the current session into parallel tmux or Ghostty panes.",
  "keywords": [
    "branch",
    "fork",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "session"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-branch#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-branch"
  },
  "files": [
    "index.ts",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node ../../scripts/tracked-check.ts lint",
    "lint:fix": "node ../../scripts/tracked-check.ts lint:fix",
    "format": "node ../../scripts/tracked-check.ts format",
    "format:check": "node ../../scripts/tracked-check.ts format:check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/package-check.ts",
    "check": "npm run format:check && npm run lint && npm run check:code",
    "check:code": "npm run typecheck && npm test && npm run check:package",
    "verify": "npm run check"
  },
  "dependencies": {
    "pi-typed-args": "0.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.19.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
