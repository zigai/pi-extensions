{
  "name": "@zigai/pi-branch",
  "version": "0.1.0",
  "description": "Pi package for branching the current session into parallel tmux or Ghostty panes.",
  "keywords": [
    "branch",
    "fork",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "session"
  ],
  "homepage": "https://github.com/zigai/pi-branch#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-branch/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-branch.git"
  },
  "files": [
    "index.ts",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint -c ./oxlint.config.ts .",
    "lint:fix": "oxlint -c ./oxlint.config.ts . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "smoke:package": "node scripts/package-smoke.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run smoke:package",
    "verify": "npm run check"
  },
  "dependencies": {
    "pi-typed-args": "file:../pi-typed-commands"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.74.0",
    "oxlint-rules": "0.4.2",
    "oxlint-tsgolint": "^7.0.2001",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "bundledDependencies": [
    "pi-typed-args"
  ],
  "bundleDependencies": [
    "pi-typed-args"
  ],
  "engines": {
    "node": ">=22.19.0 <27"
  },
  "packageManager": "npm@11.0.0",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
