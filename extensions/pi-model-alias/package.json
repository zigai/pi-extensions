{
  "name": "@zigai/pi-model-alias",
  "version": "0.5.8",
  "description": "Pi package that adds aliases for provider model IDs and provider display names.",
  "keywords": [
    "model-alias",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-tweaks",
    "provider-alias"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-model-alias#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-model-alias"
  },
  "files": [
    "src",
    "README.md",
    "*.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zigai/pi-extension-internals": "0.1.6",
    "@zigai/pi-extension-settings": "0.5.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md",
    "prevalidation": "./src/settings.prevalidated.ts"
  }
}
