{
  "name": "@zigai/pi-tree",
  "version": "0.7.1",
  "description": "Pi package that improves /tree with timestamps and preview behavior.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-tweaks",
    "timestamps",
    "tree"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks/tree/master/extensions/pi-tree#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git",
    "directory": "extensions/pi-tree"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "*.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.6.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/zigai/pi-tweaks/master/extensions/pi-tree/assets/tree-preview-demo.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtensionSettings": {
    "definition": "./src/settings-input.ts",
    "schema": "./config.schema.json",
    "readme": "./README.md",
    "prevalidation": "./src/settings.prevalidated.ts"
  }
}
