{
  "name": "pi-extensions-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for personal Pi extensions.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-extensions",
    "pi-package"
  ],
  "homepage": "https://github.com/zigai/pi-tweaks#readme",
  "bugs": {
    "url": "https://github.com/zigai/pi-tweaks/issues"
  },
  "license": "MIT",
  "author": "zigai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zigai/pi-tweaks.git"
  },
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "node scripts/workspace-tasks.ts lint",
    "lint:fix": "node scripts/workspace-tasks.ts lint:fix",
    "format": "node scripts/workspace-tasks.ts format",
    "format:check": "node scripts/workspace-tasks.ts format:check",
    "check": "npm run build && npm run check:root && npm run check:code:workspaces",
    "build:internals": "npm run build -w @zigai/pi-extension-internals",
    "architecture:check": "node scripts/architecture-check.ts",
    "collection:generate": "node scripts/generate-collection.ts generate",
    "collection:check": "node scripts/generate-collection.ts check",
    "test": "npm run build && node scripts/workspace-tasks.ts test",
    "coverage": "npm run build && node scripts/workspace-tasks.ts coverage",
    "test:package": "npm run build && npm run test:package:built",
    "typecheck": "npm run build && node scripts/workspace-tasks.ts typecheck",
    "release": "release --root .",
    "release:dry-run": "release --dry --root .",
    "config:generate": "npm run build -w @zigai/pi-extension-settings && node packages/pi-extension-settings/dist/cli-entry.js generate",
    "config:check": "npm run build -w @zigai/pi-extension-settings && node packages/pi-extension-settings/dist/cli-entry.js check",
    "build": "node scripts/workspace-tasks.ts build",
    "check:code:workspaces": "node scripts/workspace-tasks.ts check:code:workspaces",
    "check:root": "npm run architecture:check && npm run collection:check && npm run config:check && npm run format:check:root && npm run lint:root && npm run typecheck:root && npm run test:root && npm run test:package:built",
    "format:check:root": "node scripts/workspace-tasks.ts format:check:root",
    "lint:root": "node scripts/workspace-tasks.ts lint:root",
    "typecheck:root": "node scripts/workspace-tasks.ts typecheck:root",
    "test:root": "node scripts/workspace-tasks.ts test:root",
    "test:package:built": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "@zigai/pi-extension-settings": "0.6.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-rules": "0.4.3",
    "oxlint-tsgolint": "^7.0.2003",
    "typebox": "^1.3.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "*"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@earendil-works/pi-telemetry": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.1": true
  },
  "pi": {
    "extensions": [
      "./extensions/pi-model-filter/src/index.ts",
      "./extensions/pi-ui-tweaks/src/index.ts",
      "./extensions/pi-model-alias/src/index.ts",
      "./extensions/pi-tree/src/index.ts",
      "./extensions/pi-footer/src/index.ts",
      "./extensions/pi-response-renderer/src/index.ts",
      "./extensions/pi-plain-user-messages/src/index.ts",
      "./extensions/pi-message-highlights/src/index.ts",
      "./extensions/pi-status-bar/src/index.ts",
      "./extensions/pi-keymap-tweaks/src/index.ts",
      "./extensions/pi-model-modes/src/index.ts",
      "./extensions/pi-prompt-history/src/index.ts",
      "./extensions/pi-mention-anything/src/index.ts",
      "./extensions/pi-mention-skill/src/index.ts",
      "./extensions/pi-mention-project/src/index.ts",
      "./extensions/pi-trust-all-folders/src/index.ts",
      "./extensions/pi-branch/index.ts",
      "./extensions/pi-codex-core/src/index.ts",
      "./extensions/pi-glowup/dist/src/index.ts",
      "./extensions/pi-goal/src/index.ts",
      "./extensions/pi-autoname-session/src/index.ts",
      "./extensions/pi-toggles/src/index.ts",
      "./extensions/pi-settings-ui/src/index.ts",
      "./extensions/pi-expanded-skills/src/index.ts"
    ]
  },
  "piWorkspace": {
    "optionalExtensions": [],
    "collections": [
      "@zigai/pi-tweaks"
    ]
  }
}
