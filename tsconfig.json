{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "extensions/**/*.ts",
    "extensions/**/*.mjs",
    "packages/pi-extension-internals/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "oxlint.config.ts"
  ],
  "exclude": [
    "extensions/pi-branch/**",
    "extensions/pi-codex-core/**",
    "extensions/pi-glowup/**",
    "extensions/pi-goal/**",
    "extensions/pi-autoname-session/**",
    "extensions/pi-toggles/**",
    "extensions/pi-settings-ui/**",
    "extensions/pi-expanded-skills/**",
    "extensions/pi-lazy-mcp/**",
    "**/dist/**",
    "**/node_modules/**"
  ]
}
